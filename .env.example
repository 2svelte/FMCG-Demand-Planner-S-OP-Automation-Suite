# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (e.g. Azure, OpenRouter, Gemini's OpenAI-compat URL)
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.3

OMNIPLAN_HORIZON_WEEKS=12
OMNIPLAN_MAX_COVER_DAYS=120
OMNIPLAN_DEFAULT_LEAD_TIME_WEEKS=4
# OMNIPLAN_DATA_DIR=./data
